OCOP_PACK_DB_URL=sqlite:///data/ocop_packaging.db

# Execution
OCOP_ONLINE=false
OCOP_E2E_REAL_AI=false

# Planner
OCOP_PLANNER_PROVIDER=mock
OCOP_PLANNER_MODEL=mock-design-planner-v1
OCOP_PLANNER_BASE_URL=
OCOP_PLANNER_API_KEY=
OCOP_PLANNER_TIMEOUT_SECONDS=60
OCOP_PLANNER_MAX_RETRIES=1
OCOP_PLANNER_TEMPERATURE=0
OCOP_PLANNER_MAX_OUTPUT_TOKENS=2000
OCOP_PLANNER_PROMPT_VERSION=v1
OCOP_PLANNER_SCHEMA_VERSION=design-plan.v1

# Image generation
OCOP_IMAGE_PROVIDER=fixture
OCOP_IMAGE_MODEL=fixture-artwork-v1
OCOP_IMAGE_BASE_URL=
OCOP_IMAGE_API_KEY=
OCOP_IMAGE_TIMEOUT_SECONDS=120
OCOP_IMAGE_MAX_RETRIES=1
OCOP_IMAGE_DEFAULT_COUNT=2
OCOP_IMAGE_HARD_MAX_CALLS=3
OCOP_IMAGE_OUTPUT_FORMAT=png

# Visual critic
OCOP_VISION_PROVIDER=openai-compatible
OCOP_VISION_MODEL=<exact-vision-model-id>
OCOP_VISION_BASE_URL=<provider-base-url>
OCOP_VISION_API_KEY=<vision-api-key>
OCOP_VISION_TIMEOUT_SECONDS=60
OCOP_VISION_MAX_RETRIES=1
OCOP_VISION_PROMPT_VERSION=v1
OCOP_VISION_SCHEMA_VERSION=v1

# Artwork revision
OCOP_REVISION_PROVIDER=openai-compatible
OCOP_REVISION_MODEL=<exact-image-edit-model-id>
OCOP_REVISION_BASE_URL=<provider-base-url>
OCOP_REVISION_API_KEY=<revision-api-key>
OCOP_REVISION_TIMEOUT_SECONDS=120
OCOP_REVISION_MAX_RETRIES=1

# Phase 4 budget
OCOP_MAX_VISION_CALLS=1
OCOP_MAX_REVISION_COUNT=1
OCOP_MAX_IMAGE_EDIT_CALLS=1
OCOP_CONTACT_SHEET_TOP_K=6
